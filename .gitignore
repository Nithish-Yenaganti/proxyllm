# Virtual environments
.venv/
venv/
env/

# Environment variables and local secrets
.env
.env.*
!.env.example

# Python bytecode and caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
*.log
*.pid

# Local benchmark evidence can contain machine, endpoint, and workload details
benchmarks/results/*
!benchmarks/results/.gitkeep
.demo-build/

# Packaging and build output
build/
dist/
*.egg-info/

# Editors and operating systems
.DS_Store
.idea/
.vscode/

