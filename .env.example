# Maximum incoming chat JSON body: 5 MB (decimal bytes). Restart after changing.
PROXY_MAX_REQUEST_BYTES=5000000

# Real Fireworks credential used only by the server-side Fireworks adapter.
FIREWORK_API_KEY=

# OpenAI-compatible Fireworks chat-completions endpoint.
FIREWORK_URL=https://api.fireworks.ai/inference/v1/chat/completions

# Real Anthropic credential used only by the server-side Anthropic adapter.
ANTHROPIC_API_KEY=

# Direct Anthropic Messages endpoint; main.py uses this value by default too.
ANTHROPIC_URL=https://api.anthropic.com/v1/messages

# One Fireworks-authorized ProxyLLM virtual key used by the Python benchmark scripts
# and passed to k6 by benchmarks.load_sweep.
PROXY_VIRTUAL_KEY=

# Running gateway endpoint used by the Python latency and cache scripts.
PROXY_GATEWAY_URL=http://127.0.0.1:8000/v1/chat/completions

# Running gateway endpoint read by the k6 load-test script.
GATEWAY_URL=http://127.0.0.1:8000/v1/chat/completions

# Optional k6 model override. Other k6 controls are normally set by load_sweep.
MODEL=fireworks/deepseek-v4-flash

# Model required only by the legacy direct Fireworks smoketest.py script.
LLM_MODEL=accounts/fireworks/models/deepseek-v4-flash-0731
