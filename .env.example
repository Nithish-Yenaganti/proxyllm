# Real Fireworks credential used only by the server-side Fireworks adapter.
FIREWORK_API_KEY=

# OpenAI-compatible Fireworks chat-completions endpoint.
FIREWORK_URL=https://api.fireworks.ai/inference/v1/chat/completions

# Real Anthropic credential used only by the server-side Anthropic adapter.
ANTHROPIC_API_KEY=

# Direct Anthropic Messages endpoint; main.py uses this value by default too.
ANTHROPIC_URL=https://api.anthropic.com/v1/messages
